<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{pageTitle}}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{metaDescription}}">
  <meta property="og:title" content="{{pageTitle}}">
  <meta property="og:description" content="{{metaDescription}}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{canonicalUrl}}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{pageTitle}}">
  <meta name="twitter:description" content="{{metaDescription}}">
  <link rel="canonical" href="{{canonicalUrl}}">
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="stylesheet" href="/assets/home.css">
  <script type="application/ld+json" nonce="{{cspNonce}}">{{{jsonLd}}}</script>
</head>
<body data-page-context data-min-date="{{minDate}}" data-active-date="{{date}}" data-today="{{today}}" data-period="{{period}}">

<header class="app-header">
  <div class="header-content">
    <a class="logo" href="/">
      <span class="logo-icon">&#9650;</span>
      <span class="logo-text">HNAgg - Top Hacker News Stories</span>
    </a>
    <a class="github-link" href="https://github.com/kurtmoser/hnagg" target="_blank" rel="noopener noreferrer" aria-label="GitHub repository">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
      </svg>
    </a>
  </div>
</header>

<nav class="date-bar">
  <div class="date-bar-content">
    <div class="date-bar-links">
      {{#if dateBar.showNewerBtn}}
        <a class="nav-btn" href="{{dateBar.newerHref}}" title="More recent">&#8249;</a>
      {{/if}}

      {{#each dateBar.dateLinks}}
        <a class="date-link{{#if this.active}} active{{/if}}" href="{{this.href}}">{{this.label}}</a>
      {{/each}}

      {{#if dateBar.showOlderBtn}}
        <a class="nav-btn" href="{{dateBar.olderHref}}" title="Older">&#8250;</a>
      {{/if}}
    </div>

    <div class="period-toggle-wrap">
      <button class="period-toggle" id="periodToggle" aria-label="Change grouping">
        <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/></svg>
      </button>
      <div class="period-dropdown" id="periodDropdown">
        <a class="period-option{{#if periodIsDay}} active{{/if}}" href="{{cogLinks.day}}">Day</a>
        <a class="period-option{{#if periodIsWeek}} active{{/if}}" href="{{cogLinks.week}}">Week</a>
        <a class="period-option{{#if periodIsMonth}} active{{/if}}" href="{{cogLinks.month}}">Month</a>
      </div>
    </div>
  </div>
</nav>

<main>
  <section class="stories-container">
    <h1 class="sr-only">{{heading}}</h1>

    {{#if stories.length}}
    <ol class="story-list">
      {{#each stories}}
      <li class="story-item">
        <span class="rank">{{this.rank}}.</span>
        <div class="story-content">
          {{#if this.imagePath}}
            <a href="{{this.storyUrl}}" target="_blank" rel="noopener">
              <img class="story-image" src="/api/images/{{this.imagePath}}" alt="{{this.title}}" loading="lazy">
            </a>
          {{else}}
            <a href="{{this.storyUrl}}" target="_blank" rel="noopener">
              <div class="story-image-placeholder"></div>
            </a>
          {{/if}}
          <div class="story-text">
            <div class="story-title-row">
              <a class="story-title" href="{{this.storyUrl}}" target="_blank" rel="noopener">{{this.title}}</a>
              <span class="story-domain">({{this.domain}})</span>
            </div>
            <div class="story-meta">
              <span class="score">{{this.score}} points</span>
              {{#if this.by}}
                <span class="by">by {{this.by}}</span>
              {{/if}}
              <span class="time">{{this.timeAgo}}</span>
              <a class="comments" href="https://news.ycombinator.com/item?id={{this.id}}" target="_blank" rel="noopener">{{this.descendants}} comments</a>
            </div>
          </div>
        </div>
      </li>
      {{/each}}
    </ol>

    {{#if showPagination}}
    <nav class="pagination">
      {{#each pageLinks}}
        {{#if this.active}}
          <span class="page-link active">{{this.number}}</span>
        {{else}}
          <a class="page-link" href="{{this.href}}">{{this.number}}</a>
        {{/if}}
      {{/each}}
    </nav>
    {{/if}}
    {{/if}}
  </section>
</main>

<footer>
  <p>HNAgg is not affiliated with or endorsed by Y Combinator or Hacker News.</p>
</footer>

<script src="/assets/home.js" defer></script>

</body>
</html>
