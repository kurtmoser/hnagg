<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{pageTitle}}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{metaDescription}}">
  <meta property="og:title" content="{{pageTitle}}">
  <meta property="og:description" content="{{metaDescription}}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{canonicalUrl}}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{pageTitle}}">
  <meta name="twitter:description" content="{{metaDescription}}">
  <link rel="canonical" href="{{canonicalUrl}}">
  <link rel="icon" type="image/x-icon" href="data:image/x-icon;base64,">
  <script type="application/ld+json">{{{jsonLd}}}</script>
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      background: #fff;
      color: #111827;
      line-height: 1.5;
    }

    /* Header */
    .app-header {
      background: #f97316;
      padding: 0.625rem 1rem;
    }
    .header-content {
      max-width: 900px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .logo {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      text-decoration: none;
      color: white;
    }
    .logo-icon {
      font-size: 1.25rem;
      font-weight: 700;
    }
    .logo-text {
      font-size: 0.9375rem;
      font-weight: 700;
      letter-spacing: -0.01em;
    }
    .tagline {
      font-size: 0.8125rem;
      color: rgba(255, 255, 255, 0.75);
    }

    /* Date bar */
    .date-bar {
      background: #fff7ed;
      border-bottom: 1px solid #fed7aa;
      padding: 0.5rem 1rem;
    }
    .date-bar-content {
      max-width: 900px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 0.25rem;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .date-bar-content::-webkit-scrollbar {
      display: none;
    }
    .nav-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: none;
      border: none;
      padding: 0.25rem 0.5rem;
      font-size: 1.25rem;
      line-height: 1;
      color: #92400e;
      cursor: pointer;
      border-radius: 9999px;
      transition: all 0.15s ease;
      flex-shrink: 0;
      text-decoration: none;
    }
    .nav-btn:hover {
      background: #ffedd5;
    }
    .date-link {
      background: none;
      border: none;
      padding: 0.375rem 0.75rem;
      font-size: 0.8125rem;
      font-weight: 500;
      color: #92400e;
      cursor: pointer;
      white-space: nowrap;
      border-radius: 9999px;
      transition: all 0.15s ease;
      text-decoration: none;
    }
    .date-link:hover {
      background: #ffedd5;
    }
    .date-link.active {
      background: #f97316;
      color: white;
    }

    /* Stories */
    .stories-container {
      max-width: 900px;
      margin: 0 auto;
      padding: 1.5rem 1rem;
    }
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
    .story-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .story-item {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 0.75rem 0;
      border-bottom: 1px solid #f3f4f6;
      transition: background 0.15s ease;
    }
    .story-item:hover {
      background: #fafafa;
    }
    .rank {
      flex-shrink: 0;
      width: 2rem;
      text-align: right;
      color: #9ca3af;
      font-size: 0.875rem;
      font-weight: 500;
    }
    @media (max-width: 640px) {
      .rank { display: none; }
    }
    .story-content {
      flex: 1;
      min-width: 0;
      display: flex;
      gap: 0.75rem;
      align-items: flex-start;
    }
    .story-text {
      flex: 1;
      min-width: 0;
    }
    .story-title-row {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.375rem;
    }
    .story-title {
      font-size: 0.9375rem;
      font-weight: 500;
      color: #111827;
      text-decoration: none;
      line-height: 1.4;
    }
    .story-title:hover {
      color: #f97316;
    }
    .story-title:visited {
      color: #6b7280;
    }
    .story-domain {
      font-size: 0.75rem;
      color: #9ca3af;
      white-space: nowrap;
    }
    .story-image, .story-image-placeholder {
      flex-shrink: 0;
      width: 80px;
      height: 60px;
      border-radius: 6px;
    }
    .story-image {
      border: 1px solid #e5e7eb;
      object-fit: cover;
    }
    .story-image-placeholder {
      background: #f3f4f6;
    }
    .story-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 0.25rem;
      font-size: 0.75rem;
      color: #6b7280;
    }
    .story-meta .score {
      color: #f97316;
      font-weight: 500;
    }
    .story-meta .comments {
      color: inherit;
      text-decoration: underline;
    }
    .story-meta .comments:visited {
      color: inherit;
    }

    /* Pagination */
    .pagination {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.5rem;
      padding: 2rem 0;
    }
    .page-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 6px;
      font-size: 0.875rem;
      font-weight: 500;
      color: #374151;
      text-decoration: none;
      border: 1px solid #e5e7eb;
      background: #f9fafb;
      transition: all 0.15s ease;
    }
    .page-link:hover:not(.active) {
      background: #f97316;
      color: white;
      border-color: #f97316;
    }
    .page-link.active {
      background: #f97316;
      color: white;
      border-color: #f97316;
      cursor: default;
    }
  </style>
</head>
<body>

<header class="app-header">
  <div class="header-content">
    <a class="logo" href="/">
      <span class="logo-icon">&#9650;</span>
      <span class="logo-text">Hacker News Aggregator</span>
    </a>
    <span class="tagline">Top Stories</span>
  </div>
</header>

<nav class="date-bar">
  <div class="date-bar-content">
    {{#if dateBar.showNewerWeekBtn}}
      <a class="nav-btn" href="/date/{{dateBar.newerWeekDate}}" title="More recent week">&#8249;</a>
    {{/if}}

    {{#each dateBar.dateLinks}}
      <a class="date-link{{#if this.active}} active{{/if}}" href="/date/{{this.date}}">{{this.label}}</a>
    {{/each}}

    {{#if dateBar.showOlderWeekBtn}}
      <a class="nav-btn" href="/date/{{dateBar.olderWeekDate}}" title="Previous week">&#8250;</a>
    {{/if}}
  </div>
</nav>

<main>
  <section class="stories-container">
    <h1 class="sr-only">{{heading}}</h1>

    {{#if stories.length}}
    <ol class="story-list">
      {{#each stories}}
      <li class="story-item">
        <span class="rank">{{this.rank}}.</span>
        <div class="story-content">
          {{#if this.imagePath}}
            <a href="{{this.storyUrl}}" target="_blank" rel="noopener">
              <img class="story-image" src="/api/images/{{this.imagePath}}" alt="{{this.title}}" loading="lazy">
            </a>
          {{else}}
            <a href="{{this.storyUrl}}" target="_blank" rel="noopener">
              <div class="story-image-placeholder"></div>
            </a>
          {{/if}}
          <div class="story-text">
            <div class="story-title-row">
              <a class="story-title" href="{{this.storyUrl}}" target="_blank" rel="noopener">{{this.title}}</a>
              <span class="story-domain">({{this.domain}})</span>
            </div>
            <div class="story-meta">
              <span class="score">{{this.score}} points</span>
              {{#if this.by}}
                <span class="by">by {{this.by}}</span>
              {{/if}}
              <span class="time">{{this.timeAgo}}</span>
              <a class="comments" href="https://news.ycombinator.com/item?id={{this.id}}" target="_blank" rel="noopener">{{this.descendants}} comments</a>
            </div>
          </div>
        </div>
      </li>
      {{/each}}
    </ol>

    {{#if showPagination}}
    <nav class="pagination">
      {{#each pageLinks}}
        {{#if this.active}}
          <span class="page-link active">{{this.number}}</span>
        {{else}}
          <a class="page-link" href="{{this.href}}">{{this.number}}</a>
        {{/if}}
      {{/each}}
    </nav>
    {{/if}}
    {{/if}}
  </section>
</main>

<script>
(function() {
  var startX = 0, startY = 0;
  var SWIPE_THRESHOLD = 50;
  var MIN_DATE = '{{minDate}}';
  var activeDate = '{{date}}';
  var todayIso = '{{today}}';

  function addDays(date, days) {
    var d = new Date(date + 'T00:00:00Z');
    d.setUTCDate(d.getUTCDate() + days);
    return d.toISOString().slice(0, 10);
  }

  document.addEventListener('touchstart', function(e) {
    startX = e.changedTouches[0].clientX;
    startY = e.changedTouches[0].clientY;
  });

  document.addEventListener('touchend', function(e) {
    var deltaX = e.changedTouches[0].clientX - startX;
    var deltaY = e.changedTouches[0].clientY - startY;
    if (Math.abs(deltaX) > SWIPE_THRESHOLD && Math.abs(deltaX) > Math.abs(deltaY)) {
      if (deltaX > 0) {
        var next = addDays(activeDate, 1);
        if (next <= todayIso) window.location.href = '/date/' + next;
      } else {
        var prev = addDays(activeDate, -1);
        if (prev >= MIN_DATE) window.location.href = '/date/' + prev;
      }
    }
  });
})();
</script>

</body>
</html>
